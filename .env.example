# Copy this file to .env.local and fill in your own Supabase project values.
# Dashboard runs in seeded demo mode (no database) until these are set.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used by the /api/cron/switch-off route. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=choose-a-long-random-secret
